if(LOVE_SCUA)
    find_package(Theora REQUIRED)
    find_package(Ogg REQUIRED)
    target_include_directories(lovedep::Theora INTERFACE ${THEORA_INCLUDE_DIR})
    target_link_libraries(lovedep::Theora INTERFACE ${THEORADEC_LIBRARY} ${THEORA_LIBRARY})
    target_include_directories(lovedep::Ogg INTERFACE ${OGG_INCLUDE_DIR})
    target_link_libraries(lovedep::Ogg INTERFACE ${OGG_LIBRARY})
endif()
if(LOVE_SCUA AND LOVE_SCUA_AUDIO)
    option(LOVE_SCUA_FETCH_MODPLUG "Build the pinned tracker decoder without ambient file reads" OFF)
    if(LOVE_SCUA_FETCH_MODPLUG)
        include("${CMAKE_CURRENT_LIST_DIR}/Modplug.cmake")
    else()
        find_package(ModPlug REQUIRED)
        target_include_directories(lovedep::Modplug INTERFACE ${MODPLUG_INCLUDE_DIR})
        target_link_libraries(lovedep::Modplug INTERFACE ${MODPLUG_LIBRARY})
    endif()
    if(TARGET OpenAL)
        target_link_libraries(lovedep::OpenAL INTERFACE OpenAL)
        target_include_directories(lovedep::OpenAL INTERFACE "${openal_soft_SOURCE_DIR}/include/AL")
    else()
        target_include_directories(lovedep::OpenAL INTERFACE ${OPENAL_INCLUDE_DIR})
        target_link_libraries(lovedep::OpenAL INTERFACE ${OPENAL_LIBRARY})
    endif()
    find_package(Vorbis REQUIRED)
    find_package(Ogg REQUIRED)
    target_include_directories(lovedep::Vorbis INTERFACE ${VORBIS_INCLUDE_DIR})
    target_link_libraries(lovedep::Vorbis INTERFACE ${VORBISFILE_LIBRARY} ${VORBIS_LIBRARY})
    target_include_directories(lovedep::Ogg INTERFACE ${OGG_INCLUDE_DIR})
    target_link_libraries(lovedep::Ogg INTERFACE ${OGG_LIBRARY})
endif()
