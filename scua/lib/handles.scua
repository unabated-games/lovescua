-- Optional typed wrappers. Distinct enum brands prevent accidental resource mixing.
-- Native functions use wrapper.raw; runtime kind checks remain authoritative.
import love_object as object

enum TextureBrand { Value }
record Texture { raw: any, brand: TextureBrand = TextureBrand.Value }
fn texture(raw) -> Texture
  return { raw = object.assert_kind(raw, "Texture"), brand = TextureBrand.Value }
end

enum QuadBrand { Value }
record Quad { raw: any, brand: QuadBrand = QuadBrand.Value }
fn quad(raw) -> Quad
  return { raw = object.assert_kind(raw, "Quad"), brand = QuadBrand.Value }
end

