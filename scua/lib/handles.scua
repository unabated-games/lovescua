fn close(resource) object.close(resource.raw) end
fn is_open(resource) -> bool return object.is_open(resource.raw) end

return { close = close, is_open = is_open, texture = texture, quad = quad, font = font, image_data = image_data, shader = shader, sprite_batch = sprite_batch, particles = particles, sound_data = sound_data, audio_source = audio_source, decoder = decoder, recording = recording, random = random, curve = curve, transform = transform, world = world, body = body, collider = collider, joint = joint, mesh = mesh, text = text, joystick = joystick, video = video, readback = readback, cursor = cursor, buffer = buffer, compressed_image_data = compressed_image_data, rasterizer = rasterizer, glyph_data = glyph_data }
