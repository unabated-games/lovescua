--!declare love_jobs
-- Generated by scua_write_decls: describes the host API for editor tooling
-- (hover, signatures, type-checking). Not runnable; list it in scua.toml [tooling.declarations].

-- Publish copied state for actor reads; main script only, up to 1024 ids.
fn publish(id: int, snapshot: vec4) end
-- Drain copied commands sorted by step/id in post_update; engine objects stay in the main script.
fn commands() -> any end
-- Drain actor/task/unhandled Error notifications reported once; up to 64 retained records.
fn faults() -> any end
-- Get frame budget, clock, worker statistics and fault totals.
fn info() -> any end
-- Pause actor scheduling and its clock; main update/draw continue.
fn set_paused(paused: bool) end
-- Scale the actor clock from 0 to 16; applies to subsequent frame advances.
fn set_time_scale(scale: float) end
-- Assign a deferred write order key by current runtime creation index; recreate after reload.
fn set_order_key(actor_index: int, key: int) end
-- Queue copied text; false means inbox full. Tagged-only recipients fault at the next drain.
fn post_text(actor_index: int, message: string) -> bool end
