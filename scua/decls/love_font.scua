-- (hover, signatures, type-checking). Not runnable; list it in scua.toml [tooling.declarations].

-- Create a TrueType rasterizer (built-in font when encoded is nil); hinting, dpi_scale and sdf settings.
fn new_rasterizer(size: int, encoded: bytes = nil, settings: any = nil) -> any end
-- Create a retained image-strip rasterizer with separator pixels.
fn new_image_rasterizer(image: any, glyphs: string, extra_spacing: int = 0, dpi_scale: float = 1) -> any end
-- Create a BMFont from explicit ImageData pages; never load page paths from the filesystem.
fn new_bmfont_rasterizer(definition: string, pages: any, dpi_scale: float = 1) -> any end
-- Get rasterizer metrics, data type, glyph count and DPI scale.
fn rasterizer_info(rasterizer: any) -> any end
-- Get glyph existence, native index and advance spacing.
fn rasterizer_glyph_info(rasterizer: any, codepoint: int) -> any end
-- Check UTF-8 glyph coverage.
fn rasterizer_has_glyphs(rasterizer: any, text: string) -> bool end
-- Get kerning between Unicode scalars.
fn rasterizer_kerning(rasterizer: any, left: int, right: int) -> float end
-- Rasterize the first Unicode character into managed GlyphData.
fn new_glyph(rasterizer: any, character: string) -> any end
-- Rasterize a Unicode scalar.
fn new_glyph_codepoint(rasterizer: any, codepoint: int) -> any end
-- Get Unicode character, dimensions, advance, bearings, bounding box, format and byte size.
fn glyph_info(glyph: any) -> any end
-- Copy native luminance/alpha or RGBA glyph pixels.
fn glyph_bytes(glyph: any) -> bytes end
-- Clone managed glyph pixels and metrics.
fn glyph_clone(glyph: any) -> any end
-- Convert a glyph to RGBA ImageData; nil for empty glyphs.
fn glyph_image(glyph: any) -> any end
