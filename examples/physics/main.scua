import love

-- Keep gameplay state in typed SCUA records; native handles own engine objects.
enum Shape { Ball, Box, Triangle }
record Thing { body: any, shape: Shape, size: vec2, color: vec4 }
let world = nil
let things: { Thing } = []
let joints = []
let ticks = 0

-- Query results are snapshots of IDs and vectors, ready for ordinary SCUA loops.
fn check_queries()
  let w=love.physics.new_world(vec2(0,0))
  let a=love.physics.new_body(w,vec2(0,0),"static")
  let first=love.physics.new_circle(a,10,0)
  let b=love.physics.new_body(w,vec2(40,0),"dynamic")
  let second=love.physics.new_circle(b,10,1)
  let sensor=love.physics.new_box(b,vec2(16,16),0)
  love.physics.collider_set_sensor(sensor,true)
  assert(love.physics.collider_id(first)<love.physics.collider_id(second))
  assert(love.physics.collider_id(second)<love.physics.collider_id(sensor))
  let candidates=love.physics.world_query(w,vec2(-20,-20),vec2(60,20))
  assert(candidates.len()==3)
  assert(candidates[2].sensor)
  let hits=love.physics.world_raycast_all(w,vec2(-20,0),vec2(60,0))
  assert(hits.len()==3)
  assert(hits[0].collider==love.physics.collider_id(first))
  assert(hits[0].fraction<hits[1].fraction and hits[1].fraction<=hits[2].fraction)
  assert(love.physics.world_raycast_all(w,vec2(-20,100),vec2(60,100)).len()==0)
  match pcall(fn() love.physics.world_query(w,vec2(10,10),vec2(-10,-10)) end)
    Ok(_) -> assert(false,"reversed query bounds must fail")
    Error(_) -> nil
  end
  let info=love.physics.body_info(b)
  assert(info.mass>0 and info.inertia>0 and info.enabled)
  assert((info.center-vec2(40,0)).length()<0.001)
  love.physics.body_set_gravity_scale(b,-1)
  assert(love.physics.body_info(b).gravity_scale == -1)
  assert((love.physics.body_local_point(b,vec2(43,4))-vec2(3,4)).length()<0.001)
  love.physics.body_apply_impulse_at(b,vec2(0,10),vec2(40,0))
  assert(love.physics.body_velocity(b).y>0)
  let point_velocity=love.physics.body_velocity_at_point(b,vec2(40,0))
  assert((point_velocity-love.physics.body_velocity(b)).length()<0.001)
  love.physics.body_apply_angular_impulse(b,20)
  assert(love.physics.body_angular_velocity(b)>0)
  love.physics.body_apply_force_at(b,vec2(0,10),vec2(50,0))
  love.physics.body_apply_torque(b,10)
  love.physics.world_step(w,0.01)
  love.physics.collider_destroy(sensor)
  assert(love.physics.world_query(w,vec2(-20,-20),vec2(60,20)).len()==2)
end

fn load()
  check_queries()
  love.window.set_title("LÖVE + SCUA / Box2D physics")
  world = love.physics.new_world(vec2(0, 600))
  let ground = love.physics.new_body(world, vec2(480, 600), "static")
  love.physics.new_box(ground, vec2(900, 30), 0)
  for i in 0:10 do
    let position = vec2(200 + (i % 5) * 70, 100 + floor(i / 5) * 100)
    let body = love.physics.new_body(world, position, "dynamic")
    let shape = if i % 3 == 0 then Shape.Ball else if i % 3 == 1 then Shape.Box else Shape.Triangle end end
    let fixture = if shape == Shape.Ball then love.physics.new_circle(body, 22, 1) else if shape == Shape.Box then love.physics.new_box(body, vec2(42, 42), 1) else love.physics.new_polygon(body, [vec2(-21, 21), vec2(0, -21), vec2(21, 21)], 1) end end
    love.physics.collider_set_friction(fixture, 0.6)
    love.physics.collider_set_restitution(fixture, 0.25)
    assert(love.physics.collider_test_point(fixture, position))
    assert(love.physics.body_mass(body) > 0)
    things.push({ body = body, shape = shape, size = if shape == Shape.Ball then vec2(44, 44) else vec2(42, 42) end, color = vec4(0.3 + i * 0.06, 0.8, 0.9 - i * 0.05, 1) })
  end
  let anchor = love.physics.new_body(world, vec2(760, 120), "static")
  let pendulum = love.physics.new_body(world, vec2(840, 200), "dynamic")
  love.physics.new_circle(pendulum, 25, 1)
  love.physics.body_set_velocity(pendulum, vec2(80, 0))
  joints.push(love.physics.new_distance_joint(anchor, pendulum, vec2(760, 120), vec2(840, 200)))
  things.push({ body = pendulum, shape = Shape.Ball, size = vec2(50, 50), color = vec4(1, 0.65, 0.25, 1) })
end

fn update(dt: float)
  ticks = ticks + 1
  love.physics.world_step(world, dt)
end

fn keypressed(key: string)
  if key == "Escape" then love.event.quit() end
end

fn draw()
  love.graphics.set_color(vec4(0.45, 0.5, 0.6, 1))
  love.graphics.rectangle("fill", vec2(30, 585), vec2(900, 30))
  for thing in things do
    love.graphics.push_state()
    love.graphics.translate(love.physics.body_position(thing.body))
    love.graphics.rotate(love.physics.body_angle(thing.body))
    love.graphics.set_color(thing.color)
    match thing.shape
      Shape.Ball -> love.graphics.circle("fill", vec2(0, 0), thing.size.x / 2)
      Shape.Box -> love.graphics.rectangle("fill", thing.size * -0.5, thing.size)
      Shape.Triangle -> love.graphics.polygon("fill", [vec2(-21, 21), vec2(0, -21), vec2(21, 21)])
    end
    love.graphics.set_color(vec4(0.1, 0.2, 0.3, 1))
    love.graphics.line([vec2(0, 0), vec2(thing.size.x / 2, 0)])
    love.graphics.pop_state()
  end
  love.graphics.set_color(vec4(1, 1, 1, 1))
  love.graphics.line([vec2(760, 120), love.physics.body_position(things[10].body)])
  love.graphics.print("Managed worlds / bodies / fixtures / joints / contacts / ray casts", vec2(30, 30))
end

fn verify()
  assert(ticks == 180)
  assert(love.physics.world_stats(world).bodies == 13)
  assert(love.physics.world_stats(world).joints == 1)
  assert(love.physics.world_contacts(world).len() > 0)
  let hit = love.physics.world_raycast(world, vec2(40, 500), vec2(40, 620))
  assert(hit != nil and hit.fraction > 0 and hit.fraction < 1)
  assert(hit.collider>0)
  for contact in love.physics.world_contacts(world) do
    assert(contact.collider_a>0 and contact.collider_b>0)
  end
  assert(abs(hit.point.y - 585) < 0.1)
  for thing in things do
    let position = love.physics.body_position(thing.body)
    assert(position.y < 600)
  end
  print("PASS: physics bodies, collider IDs, queries, point forces, collisions, joints and ray casts")
end
