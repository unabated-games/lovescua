import controller

let bounds = vec4(0, 0, 1000, 1000)
let player = controller.new_player(vec2(100, 100))
controller.step(player, vec2(1, 0), 0.125, bounds)
assert(player.position == vec2(122.5, 100))
assert(player.facing == controller.Facing.Right)
assert(player.motion == controller.Motion.Walking)
assert(player.frame == 1)
controller.step(player, vec2(1, 1), 0.125, bounds)
assert(abs((player.position - vec2(122.5, 100)).length() - 22.5) < 0.0001)
assert(player.facing == controller.Facing.Down)
controller.step(player, vec2(-1, 0), 0.125, bounds)
assert(player.facing == controller.Facing.Left and player.frame == 3)
controller.step(player, vec2(0, -1), 0.125, bounds)
assert(player.facing == controller.Facing.Up and player.frame == 0)
controller.step(player, vec2(0, 0), 0.125, bounds)
assert(player.motion == controller.Motion.Idle and player.frame == 0)
assert(player.clock == 0)
controller.step(player, vec2(-1, -1), 100.0, bounds)
assert(player.position == vec2(0, 0))
controller.step(player, vec2(1, 1), 100.0, bounds)
assert(player.position == vec2(1000, 1000))
print("PASS: sprite controller (movement, diagonal speed, direction, animation, idle, bounds)")
