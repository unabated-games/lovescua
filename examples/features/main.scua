import love

let font = nil
let image = nil
let canvas = nil
let shader = nil
let ticks = 0

fn load()
  love.window.set_mode(960, 640)
  love.window.set_title("LÖVE + SCUA / features")
  font = love.graphics.new_font(26)
  love.graphics.set_font(font)
  assert(love.graphics.font_width(font, "SCUA") > 20)
  assert(love.graphics.font_has_glyphs(font, "Hello"))
  assert(love.graphics.font_metrics(font).height > 10)
  assert(love.graphics.font_wrap(font, "one two three four", 80).len() >= 2)
  assert(love.window.mode().width == 960)
  assert(love.window.display_count() > 0)
  assert(love.system.processor_count() > 0)
  assert(love.system.memory_size() > 0)
  love.keyboard.set_key_repeat(true)
  assert(love.keyboard.has_key_repeat())
  love.keyboard.set_key_repeat(false)
  let data = love.image.new_data(8, 8)
  assert(love.image.dimensions(data) == vec2(8, 8))
  assert(love.image.size(data) == 256)
  love.image.set_pixel(data, 3, 4, vec4(1, 0.5, 0.25, 1))
  assert(love.image.get_pixel(data, 3, 4).x == 1)
  let encoded = love.image.encode_png(data)
  let decoded = love.image.decode(encoded)
  assert(love.image.get_pixel(decoded, 3, 4).x == 1)
  let clone = love.image.clone(data)
  love.image.set_pixel(data, 3, 4, vec4(0, 0, 0, 0))
  assert(love.image.get_pixel(clone, 3, 4).x == 1)
  image = love.graphics.new_image_from_data(clone)
  canvas = love.graphics.new_canvas(192, 128)
  shader = love.graphics.new_shader("extern vec4 tint; extern Image overlay; vec4 effect(vec4 color, Image tex, vec2 uv, vec2 px) { return Texel(tex, uv) * color * tint * Texel(overlay, vec2(0.5)); }")
  assert(love.graphics.shader_has_uniform(shader, "tint"))
  love.graphics.shader_send(shader, "tint", vec4(0.4, 1, 0.8, 1))
  let pixel = love.image.new_data(1, 1)
  love.image.set_pixel(pixel, 0, 0, vec4(1, 1, 1, 1))
  let mask = love.graphics.new_image_from_data(pixel)
  love.graphics.shader_send_texture(shader, "overlay", mask)
  love.graphics.release(mask)
end

fn update(dt: float)
  ticks = ticks + 1
  assert(love.timer.get_delta() == dt)
  assert(love.timer.get_elapsed() > 0)
end

fn draw()
  love.graphics.clear(vec4(0.035, 0.055, 0.08, 1))
  love.graphics.set_color(vec4(0.3, 0.9, 0.75, 1))
  love.graphics.print("SCUA / FEATURE GALLERY", vec2(32, 26))
  love.graphics.push_state("all")
  love.graphics.translate(vec2(150, 200))
  love.graphics.scale(vec2(2, 2))
  let point = love.graphics.transform_point(vec2(5, 10))
  assert((point - vec2(160, 220)).length() < 0.001)
  assert((love.graphics.inverse_transform_point(point) - vec2(5, 10)).length() < 0.001)
  love.graphics.rotate(0.2)
  love.graphics.rounded_rectangle("fill", vec2(-40, -30), vec2(80, 60), vec2(10, 10))
  love.graphics.pop_state()
  assert(love.graphics.stack_depth() == 0)
  love.graphics.set_color(vec4(0.9, 0.6, 0.3, 1))
  love.graphics.ellipse("fill", vec2(380, 200), vec2(80, 45))
  love.graphics.polygon("fill", [vec2(540, 240), vec2(620, 130), vec2(700, 240)])
  love.graphics.set_line_width(3)
  assert(love.graphics.line_width() == 3)
  love.graphics.line([vec2(740, 240), vec2(780, 150), vec2(820, 210), vec2(900, 160)])
  love.graphics.set_scissor(vec4(32, 290, 420, 100))
  assert(love.graphics.scissor() == vec4(32, 290, 420, 100))
  love.graphics.intersect_scissor(vec4(32, 290, 400, 100))
  love.graphics.set_color(vec4(0.25, 0.4, 0.8, 1))
  love.graphics.circle("fill", vec2(240, 340), 180)
  love.graphics.clear_scissor()
  assert(love.graphics.scissor() == nil)
  love.graphics.set_canvas(canvas)
  love.graphics.clear(vec4(0.1, 0.4, 0.7, 1))
  love.graphics.set_color(vec4(1, 1, 1, 1))
  love.graphics.circle("fill", vec2(96, 64), 40)
  love.graphics.set_canvas(nil)
  love.graphics.set_shader(shader)
  love.graphics.draw(canvas, vec2(520, 285))
  love.graphics.set_shader(nil)
  love.graphics.draw(image, vec2(740, 300), 0, vec2(12, 12))
  love.graphics.set_color(vec4(0.8, 0.86, 0.95, 1))
  love.graphics.printf("Transforms / shapes / clipping / fonts / CPU pixels / canvases / shaders", vec2(32, 460), 880, "left")
  love.graphics.printf(`{love.graphics.renderer_info().name}  /  {love.system.get_os()}  /  {love.timer.get_fps()} fps`, vec2(32, 550), 880, "left")
end

fn keypressed(key: string)
  if key == "Escape" then love.event.quit() end
end

fn verify()
  assert(ticks == 3)
  assert(love.graphics.stats().textures > 0)
  assert(love.graphics.font_metrics(font).height > 0)
  assert(love.graphics.blend_mode().mode == "alpha")
  print("PASS: feature gallery")
end
